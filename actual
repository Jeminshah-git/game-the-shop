var cart = [];
var drawer = $('#drawer'), scrim = $('#scrim');
function syncScrim(){ scrim.classList.toggle('on', drawer.classList.contains('on') || pdialog.classList.contains('on')); }
function openCart(){ drawer.classList.add('on'); drawer.setAttribute('aria-hidden','false'); syncScrim(); }
