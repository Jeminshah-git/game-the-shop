  var key = ART_MAP[p.id] || ART_BY_TYPE[p.type] || 'csecase';
  return '<svg class="pa" viewBox="0 0 100 100" style="--pc:'+col+'" role="img" aria-label="'+esc(p.name)+'">'+
           ART[key] +
         '</svg>';
}

/* real photo when `img` is set, drawn art otherwise or on load failure */
function artHTML(p){
  if(!p.img) return boxHTML(p);
  var src = /^https?:\/\//.test(p.img) ? p.img : IMG_BASE + p.img;
  return '<img class="card__img" src="'+esc(src)+'" alt="'+esc(p.name)+'" loading="lazy" '+
         'onerror="this.parentNode.classList.add(\'noimg\');this.remove();">' + boxHTML(p);
}

