/* ================= product detail dialog ================= */
var pdialog = $('#pdialog');
var pdLastFocus = null;
function openProduct(id){
  var p = find(id); if(!p) return;
  pdLastFocus = document.activeElement;
  $('#pdCat').textContent = p.type + (p.genre ? ' · ' + p.genre : '');
  $('#pdTitle').textContent = p.name;
  $('#pdSpec').textContent = p.spec;
  $('#pdPlat').textContent = p.plat === 'Multi' ? 'All platforms' : p.plat;
  $('#pdPrice').innerHTML = inr(p.price) + (p.mrp ? '<s>'+inr(p.mrp)+'</s>' : '');
  $('#pdArt').innerHTML = artHTML(p);
  $('#pdAdd').dataset.add = p.id;
  pdialog.classList.add('on');
  pdialog.setAttribute('aria-hidden','false');
  syncScrim();
  $('#pdClose').focus();
}
function closeProduct(){
  if(!pdialog.classList.contains('on')) return;
  pdialog.classList.remove('on');
  pdialog.setAttribute('aria-hidden','true');
  syncScrim();
  if(pdLastFocus && pdLastFocus.focus) pdLastFocus.focus();
}
$('#pdClose').addEventListener('click', closeProduct);

document.addEventListener('keydown', function(e){
  if(e.key === 'Escape'){ closeCart(); closeMenu(); closeProduct(); return; }
  if((e.key === 'Enter' || e.key === ' ') && e.target.classList && e.target.classList.contains('card__hit')){
    e.preventDefault(); e.target.click(); return;
  }
  if(e.key === 'Tab' && pdialog.classList.contains('on')){
    var focusables = $$('button, [href], input, [tabindex]:not([tabindex="-1"])', pdialog);
    if(!focusables.length) return;
    var first = focusables[0], last = focusables[focusables.length-1];
    if(e.shiftKey && document.activeElement === first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement === last){ e.preventDefault(); first.focus(); }
  }
});

var toastTimer;
function toast(msg){
  $('#toastMsg').textContent = msg;
  var t = $('#toast'); t.classList.add('on');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(function(){ t.classList.remove('on'); }, 2600);
}
function add(id){
  var p = find(id); if(!p) return;
  var line = cart.filter(function(c){return c.id===id})[0];
  if(line){ line.qty++; } else { cart.push({id:id, qty:1}); }
  drawCart();
  toast(p.name + ' added to cart');
}
document.addEventListener('click', function(e){
  var t = e.target.closest ? e.target.closest('[data-add]') : null;
  if(t){ add(t.dataset.add); return; }
  var hit = e.target.closest ? e.target.closest('.card__hit') : null;
  if(hit) openProduct(hit.dataset.id);
});

function drawCart(){
  var list = $('#cartList'), foot = $('#cartFoot');
  var total = cart.reduce(function(s,c){ return s + find(c.id).price * c.qty; }, 0);
  var units = cart.reduce(function(s,c){ return s + c.qty; }, 0);
  var badge = $('#cartCount');
  badge.textContent = units;
  badge.classList.toggle('on', units > 0);

  if(!cart.length){
    list.innerHTML = '<div class="drawer__empty">Your cart is empty.<br>Pick a platform and start filling it.</div>';
    foot.hidden = true;
    return;
  }
  foot.hidden = false;
  list.innerHTML = cart.map(function(c){
    var p = find(c.id);
    return '<div class="line">'+
      '<div class="line__art">'+artHTML(p)+'</div>'+
      '<div>'+
        '<div class="line__nm">'+esc(p.name)+'</div>'+
        '<div class="line__meta">'+esc(p.plat==='Multi'?'All platforms':p.plat)+' · '+inr(p.price)+'</div>'+
        '<div class="qty">'+
          '<button data-q="-" data-id="'+p.id+'" aria-label="Reduce quantity">\u2212</button>'+
          '<span>'+c.qty+'</span>'+
          '<button data-q="+" data-id="'+p.id+'" aria-label="Increase quantity">+</button>'+
        '</div>'+
      '</div>'+
      '<div class="line__rt">'+
        '<div class="price">'+inr(p.price*c.qty)+'</div>'+
        '<button class="line__rm" data-rm="'+p.id+'">Remove</button>'+
      '</div>'+
    '</div>';
  }).join('');

  var allDigital = cart.every(function(c){ return find(c.id).type === 'Digital'; });
  var freeShip = allDigital || total > FREE_SHIP_ABOVE;
  var shipCost = freeShip ? 0 : FLAT_SHIP;

  var hint = $('#freehint');
  if(!freeShip){
    hint.hidden = false;
    hint.textContent = 'Add ' + inr((FREE_SHIP_ABOVE + 1) - total) + ' more for free shipping';
  } else { hint.hidden = true; }

  $('#sub').textContent   = inr(total);
  $('#ship').textContent  = allDigital ? 'No shipping — digital' : (freeShip ? 'Free' : inr(shipCost));
  $('#grand').textContent = inr(total + shipCost);
}
drawCart();

$('#cartList').addEventListener('click', function(e){
  var q  = e.target.closest ? e.target.closest('[data-q]')  : null;
  var rm = e.target.closest ? e.target.closest('[data-rm]') : null;
  if(q){
    var line = cart.filter(function(c){return c.id===q.dataset.id})[0];
    if(!line) return;
    line.qty += (q.dataset.q === '+' ? 1 : -1);
    if(line.qty < 1) cart = cart.filter(function(c){return c.id!==line.id});
    drawCart();
  }
  if(rm){
    cart = cart.filter(function(c){return c.id!==rm.dataset.rm});
    drawCart();
    toast('Removed from cart');
  }
});
$('#checkout').addEventListener('click', function(){
  toast('Checkout not connected yet — wire this to your payment gateway');
});

/* ================= release countdown ================= */
(function(){
  var clock = $('#clock'); if(!clock) return;
  var end = new Date(RELEASE_DATE);
  function tick(){
    var diff = end - new Date();
    if(diff < 0) diff = 0;
    var s = Math.floor(diff/1000);
    var parts = [Math.floor(s/86400), Math.floor(s%86400/3600), Math.floor(s%3600/60), s%60];
    ['[data-d]','[data-h]','[data-m]','[data-s]'].forEach(function(sel,i){
      $(sel, clock).textContent = String(parts[i]).padStart(2,'0');
    });
  }
  tick(); setInterval(tick,1000);
})();

/* ================= newsletter ================= */
$('#subBtn').addEventListener('click', function(){
  var input = $('#email'), note = $('#subNote');
  var v = input.value.trim();
  note.classList.remove('err','good');
  if(!v){ note.textContent = 'Enter an email address to sign up.'; note.classList.add('err'); input.focus(); return; }
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)){ note.textContent = 'That address looks incomplete — check the @ and the domain.'; note.classList.add('err'); input.focus(); return; }
  note.textContent = 'You\u2019re on the list. First email lands this week.';
  note.classList.add('good');
  input.value = '';
  toast('Subscribed to release alerts');
});
$('#email').addEventListener('keydown', function(e){ if(e.key === 'Enter') $('#subBtn').click(); });

/* ================= mobile menu ================= */
var nav = $('#nav'), burger = $('#burger');
function closeMenu(){ nav.classList.remove('open'); burger.setAttribute('aria-expanded','false'); }
burger.addEventListener('click', function(){
  var open = nav.classList.toggle('open');
  burger.setAttribute('aria-expanded', open ? 'true' : 'false');
});
$$('#nav a').forEach(function(a){ a.addEventListener('click', closeMenu); });

/* ================= reveal + spine ================= */
if('IntersectionObserver' in window){
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
  }, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
  $$('.rv').forEach(function(el){ io.observe(el); });
} else { $$('.rv').forEach(function(el){ el.classList.add('in'); }); }

(function(){
  var flow = $('#spineFlow'); if(!flow) return;
  function update(){
    var max = document.documentElement.scrollHeight - window.innerHeight;
    var p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
    flow.setAttribute('d','M17 0 L17 '+(p*1000).toFixed(1));
  }
  update();
  window.addEventListener('scroll', update, {passive:true});
  window.addEventListener('resize', update);
})();

/* ================= reticle ================= */
(function(){
  if(reduce) return;
  if(!window.matchMedia('(pointer: fine)').matches) return;
  var r = $('#reticle'), x=0, y=0, tx=0, ty=0, raf=null;
  window.addEventListener('mousemove', function(e){
    tx = e.clientX; ty = e.clientY;
    r.classList.add('is-live');
    var el = e.target;
    var hot = (el && el.closest) ? el.closest('a,button,input,.card,.slot,.chip,[role="button"]') : null;
    r.classList.toggle('is-hot', !!hot);
    if(!raf) raf = requestAnimationFrame(loop);
  }, {passive:true});
  window.addEventListener('mouseout', function(e){ if(!e.relatedTarget) r.classList.remove('is-live'); });
  function loop(){
    x += (tx-x)*0.22; y += (ty-y)*0.22;
    r.style.left = x+'px'; r.style.top = y+'px';
    if(Math.abs(tx-x)>.4 || Math.abs(ty-y)>.4){ raf = requestAnimationFrame(loop); } else { raf = null; }
  }
})();

})();
