var state = {plat:'All', type:'All', q:''};

function cardHTML(p){
  var tagClass = p.tagType ? ' '+p.tagType : '';
  return '<article class="card notch">'+
    '<button type="button" class="card__hit" data-id="'+p.id+'" aria-label="View details for '+esc(p.name)+', '+inr(p.price)+'">'+
      '<div class="card__art'+(p.img?' has-img':'')+'">'+artHTML(p)+
        (p.tag?'<span class="card__tag'+tagClass+'">'+esc(p.tag)+'</span>':'')+
        '<span class="card__plat">'+esc(p.plat==='Multi'?'All platforms':p.plat)+'</span>'+
      '</div>'+
      '<div class="card__body">'+
        '<span class="card__cat">'+esc(p.type)+(p.genre?' · '+esc(p.genre):'')+'</span>'+
        '<h3 class="card__name">'+esc(p.name)+'</h3>'+
        '<p class="card__spec">'+esc(p.spec)+'</p>'+
      '</div>'+
    '</button>'+
    '<div class="card__foot">'+
      '<div class="price">'+inr(p.price)+(p.mrp?'<s>'+inr(p.mrp)+'</s>':'')+'</div>'+
      '<button class="btn btn--sm" data-add="'+p.id+'" aria-label="Add '+esc(p.name)+' to cart">Add</button>'+
    '</div>'+
  '</article>';
}

function render(){
  var q = state.q.trim().toLowerCase();
  var list = PRODUCTS.filter(function(p){
    var okP = state.plat === 'All' || p.plat === state.plat || p.plat === 'Multi';
    var okT = state.type === 'All' || p.type === state.type;
    var hay = (p.name+' '+p.spec+' '+p.type+' '+p.plat+' '+(p.genre||'')).toLowerCase();
    return okP && okT && (!q || hay.indexOf(q) > -1);
  });

  var rl = $('#resultline');
  var bits = [];
  if(state.plat !== 'All') bits.push(state.plat);
  if(state.type !== 'All') bits.push(state.type);
  rl.innerHTML = 'Showing <b>'+list.length+'</b> product'+(list.length===1?'':'s')+
                 (bits.length ? ' · '+esc(bits.join(' · ')) : '') +
                 (q ? ' · matching "'+esc(state.q.trim())+'"' : '');

  var grid = $('#grid');
  grid.innerHTML = list.length
    ? list.map(cardHTML).join('')
    : '<div class="empty"><p>No products match those filters.</p><small>Clear a filter or try a shorter search — the full catalogue has '+PRODUCTS.length+' items.</small></div>';
}
render();

function setChip(group, val){
